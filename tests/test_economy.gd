extends SceneTree

var checks := 0
var failures := 0

func _initialize() -> void:
	if not _check(FileAccess.file_exists("res://scripts/economy/simulation.gd"), "economic core exists"):
		quit(1)
		return
	var model = load("res://scripts/economy/simulation.gd")
	if model == null:
		_check(false, "economic core parses")
		quit(1)
		return
	var sim = model.new()
	sim.new_game("RU", 42)
	_check(sim.player_cash() == 50000000, "start capital in kopecks")
	_check(sim.validate_state(sim.state).is_empty(), "new state validates")
	var initial = sim.state.duplicate(true)
	_check(not sim.open_business("missing", 1).ok, "unknown sector rejected")
	_check(sim.state == initial, "failed action is atomic")
	_check(not sim.open_business("shop", 99).ok, "invalid plot rejected")
	_check(sim.open_business("shop", 5).ok, "open shop on vacant plot")
	var shop = _player_business(sim)
	_check(not sim.open_business("cafe", 5).ok, "plot cannot be occupied twice")
	var cash_after_open: int = sim.player_cash()
	_check(sim.financials().revenue == 0, "equipment purchase is not sales")
	_check(sim.financials().assets > cash_after_open, "equipment remains on balance sheet")
	_check(not sim.order_stock(shop.id, -10).ok, "negative stock order rejected")
	_check(sim.order_stock(shop.id, 100).ok, "stock order accepted")
	_check(shop.stock == 0, "orders do not arrive immediately")
	_check(sim.hire(shop.id).ok, "hire a real worker")
	sim.end_day()
	_check(shop.stock == 0, "standard supplier has lead time")
	sim.end_day()
	_check(shop.stock >= 0 and shop.stock < 100, "delivered stock sold within available stock")
	_check(shop.last_report.revenue > 0, "staffed stocked shop makes sales")
	_check(shop.last_report.cogs > 0, "sales consume inventory value")
	_check(shop.last_report.net_profit != shop.last_report.cash_flow, "profit differs from cash flow")
	_check(_balanced(sim), "journal balances after sales and delivery")
	_check(sim.financials().assets - sim.financials().liabilities == sim.financials().equity, "accounting equation")
	_check(sim.set_price(shop.id, 99999999).ok, "player may choose an expensive price")
	sim.end_day()
	_check(shop.last_report.units == 0, "prohibitive price loses demand")
	_check(shop.last_report.net_profit < 0, "business can lose money")
	var before_loan: int = sim.player_cash()
	var revenue_before: int = sim.financials().revenue
	_check(sim.take_loan(5000000, 30).ok, "eligible player can borrow")
	_check(sim.player_cash() == before_loan + 5000000, "loan increases cash")
	_check(sim.financials().revenue == revenue_before, "loan is not revenue")
	var debt_before: int = sim.state.loans[-1].remaining
	sim.end_day()
	_check(sim.state.loans[-1].remaining < debt_before, "scheduled principal is repaid")
	_check(sim.financials().interest > 0, "interest charged independently")
	_check(_balanced(sim), "loan entries balanced")
	var other = model.new()
	other.new_game("RU", 42)
	_check(other.open_business("cafe", 6).ok, "cafe opens")
	var cafe = _player_business(other)
	_check(other.hire(cafe.id).ok, "cafe staff")
	_check(other.order_stock(cafe.id, 90, "express").ok, "express delivery")
	other.end_day()
	_check(cafe.last_report.revenue > 0, "express delivery available next day")
	var huge = other.state.duplicate(true)
	_check(not other.order_stock(cafe.id, 1000000).ok, "warehouse cap enforced")
	_check(other.state == huge, "rejected order does not charge money")
	var service = model.new()
	service.new_game("RU", 42)
	service.open_business("studio", 1)
	var studio = _player_business(service)
	service.hire(studio.id)
	service.end_day()
	_check(studio.last_report.revenue > 0, "services sell without physical inventory")
	_check(service.financials().receivables > 0, "service invoices create receivables")
	_check(service.financials().cash_flow < service.financials().net_profit, "invoice revenue is not instant cash")
	var clone = model.new()
	clone.new_game("RU", 42)
	clone.state = service.state.duplicate(true)
	for day in range(40):
		service.end_day()
		clone.end_day()
	_check(service.state == clone.state, "same save produces deterministic future")
	_check(_balanced(service), "forty-day journal remains balanced")
	_check(service.validate_state(service.state).is_empty(), "long simulation validates")
	var bad: Dictionary = service.state.duplicate(true)
	bad.companies[0].stock = -1
	_check(not service.validate_state(bad).is_empty(), "negative inventory save rejected")
	bad = service.state.duplicate(true)
	bad.entities.player.accounts.cash += 1
	_check(not service.validate_state(bad).is_empty(), "unbalanced financial save rejected")
	var estate = model.new()
	estate.new_game("RU", 5)
	_check(estate.buy_property(12).ok, "buy affordable property")
	_check(estate.financials().revenue == 0, "property purchase not revenue")
	_check(estate.sell_property(12).ok, "sell owned property")
	_check(not estate.sell_property(12).ok, "cannot sell property twice")
	_check(_balanced(estate), "property disposal balances")
	var poor = model.new()
	poor.new_game("RU", 9)
	poor.open_business("cafe", 1)
	var bad_cafe = _player_business(poor)
	for i in range(4): poor.hire(bad_cafe.id)
	for day in range(240):
		if poor.state.bankrupt: break
		poor.end_day()
	_check(poor.state.bankrupt, "unfunded expenses eventually cause bankruptcy")
	_check(not poor.open_business("shop", 7).ok, "bankrupt company cannot expand")
	var first_ai = sim.state.companies[0]
	_check(first_ai.owner == "ai" and first_ai.last_report.revenue > 0, "competitors trade through same market")
	_check(sim.aira().size() > 0, "AIRA has evidence-based advice")
	var recovery = model.new()
	recovery.new_game("RU", 42)
	recovery.open_business("cafe", 9)
	var recovery_cafe = _player_business(recovery)
	recovery.order_stock(recovery_cafe.id, 40, "credit")
	_check(recovery.financials().payables > 0 and recovery.financials().in_transit > 0, "supplier credit records asset and liability")
	var credit_cash: int = recovery.player_cash()
	_check(recovery.financials().revenue == 0, "trade credit is not sales")
	recovery.close_business(recovery_cafe.id)
	for i in range(9): recovery.end_day()
	_check(recovery.financials().inventory == 0 and recovery.financials().in_transit == 0, "closed business liquidates deliveries")
	_check(recovery.financials().payables == 0, "supplier still paid after business closure")
	_check(recovery.validate_state(recovery.state).is_empty(), "closed business state validates")
	var perishable = model.new()
	perishable.new_game("RU", 3)
	perishable.open_business("cafe", 10)
	var perishable_cafe = _player_business(perishable)
	perishable.order_stock(perishable_cafe.id, 20, "express")
	for i in range(9): perishable.end_day()
	_check(perishable_cafe.stock == 0, "unsold cafe stock expires")
	_check(perishable.financials().inventory == 0, "expired stock removed from balance sheet")
	_check(perishable.validate_state(perishable.state).is_empty(), "spoilage journal reconciles")
	bad = estate.state.duplicate(true)
	bad.properties.append({"plot_id": 7, "owner": "player", "book_value": 100, "condition": 1.0, "listed": false, "tenant_until": 0})
	_check(not estate.validate_state(bad).is_empty(), "unrecorded property in save rejected")
	bad = service.state.duplicate(true)
	bad.receipts.append({"entity": "player", "company_id": studio.id, "amount": 999999, "due_day": 200})
	_check(not service.validate_state(bad).is_empty(), "unrecorded invoice in save rejected")
	bad = recovery.state.duplicate(true)
	bad.bills.append({"id": "fake", "entity": "player", "company_id": recovery_cafe.id, "category": "supplier", "amount": 999999, "due_day": 200})
	_check(not recovery.validate_state(bad).is_empty(), "unrecorded payable in save rejected")
	var json_roundtrip: Dictionary = JSON.parse_string(JSON.stringify(service.state))
	_check(service.validate_state(json_roundtrip).is_empty(), "JSON numeric round trip accepted")
	var us = model.new()
	us.new_game("US", 42)
	_check(us.country.currency == "USD" and us.country.experimental, "US profile is selectable and honest")
	_check(us.player_cash() == 5000000 and us.city.id == "rivergate", "country-specific capital and city")
	_check(us.validate_state(us.state).is_empty(), "US ledger validates")
	var landlord = model.new()
	landlord.new_game("RU", 12)
	landlord.buy_property(0)
	var tenant = landlord.state.companies[0]
	var tenant_cash: int = landlord.state.entities[tenant.entity].accounts.cash
	landlord._post(tenant.entity, {"cash": -tenant_cash, "equity": tenant_cash}, "withdrawal", "Owner removes liquid funds")
	landlord._operating_costs(tenant)
	_check(landlord.financials().receivables > 0, "unpaid tenant rent remains collectible")
	var landlord_cash: int = landlord.player_cash()
	landlord._post(tenant.entity, {"cash": 500000, "equity": -500000}, "capital", "Owner funds arrears")
	landlord._pay_bills()
	_check(landlord.player_cash() > landlord_cash, "tenant arrears actually reach property owner")
	_check(landlord.financials().receivables == 0, "rent collection clears receivable")
	_check(landlord.validate_state(landlord.state).is_empty(), "rental arrears reconcile after collection")
	bad = service.state.duplicate(true)
	var last_operation = bad.journal.pop_back()
	bad.journal.push_front(last_operation)
	_check(not service.validate_state(bad).is_empty(), "journal chronology is enforced")
	var taxable = model.new()
	taxable.new_game("RU", 42)
	taxable.open_business("studio", 1)
	var taxable_studio = _player_business(taxable)
	taxable.hire(taxable_studio.id)
	taxable.end_day()
	var taxable_accounts: Dictionary = taxable.state.entities.player.accounts
	var cumulative_pretax: int = -int(taxable_accounts.revenue) - int(taxable_accounts.other_income)
	for key in ["cogs", "wages", "rent", "marketing", "training", "maintenance", "depreciation", "interest", "penalties", "registration", "disposal_loss"]:
		cumulative_pretax -= int(taxable_accounts[key])
	var expected_tax: int = int(round(float(maxi(0, cumulative_pretax)) * float(taxable.country.profit_tax)))
	_check(int(taxable_accounts.tax) == expected_tax, "tax includes expenses paid between day closures")
	var credit_limit = model.new()
	credit_limit.new_game("RU",42)
	credit_limit.open_business("shop",8)
	var credit_shop = _player_business(credit_limit)
	var before_rejected_credit: Dictionary = credit_limit.state.duplicate(true)
	_check(not credit_limit.order_stock(credit_shop.id,450,"credit").ok,"new supplier debt cannot cross credit limit")
	_check(credit_limit.state == before_rejected_credit,"over-limit supplier order is atomic")
	_check(credit_limit.order_stock(credit_shop.id,100,"credit").ok,"supplier credit remains available below the limit")
	var calendar = load("res://scripts/core/calendar.gd")
	var demand_model = load("res://scripts/market/demand.gd")
	_check(calendar.parts(4).weekday == 6,"game calendar starts on actual Gregorian weekday")
	_check(demand_model.demand_for("studio",4,sim.catalog,{"demand":1.0},42000) < demand_model.demand_for("studio",6,sim.catalog,{"demand":1.0},42000),"Saturday service demand follows displayed calendar")
	_check(demand_model.demand_for("studio",5,sim.catalog,{"demand":1.0},42000) < demand_model.demand_for("studio",6,sim.catalog,{"demand":1.0},42000),"Sunday service demand follows displayed calendar")
	_check(calendar.parts(366).year == 2026 and calendar.parts(91).quarter == 2,"calendar crosses years and quarters")
	_check(calendar.parts(1155).day == 29 and calendar.parts(1155).month == 2,"calendar includes leap years")
	print("ECONOMY TESTS: %d passed / %d checks" % [checks - failures, checks])
	quit(1 if failures else 0)

func _player_business(sim):
	for company in sim.state.companies:
		if company.owner == "player": return company
	return {}

func _balanced(sim) -> bool:
	for row in sim.state.journal:
		var amount := 0
		for value in row.postings.values(): amount += int(value)
		if amount != 0: return false
	return true

func _check(condition: bool, label: String) -> bool:
	checks += 1
	if not condition:
		failures += 1
		push_error("FAIL: " + label)
	else:
		print("PASS: " + label)
	return condition
